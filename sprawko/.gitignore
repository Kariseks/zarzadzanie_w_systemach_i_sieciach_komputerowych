# 1. Ignoruj absolutnie wszystko
*

# 2. Nie ignoruj samego pliku .gitignore (opcjonalne, ale zalecane)
!.gitignore

# 3. Dodaj swoje wyjątki (pliki, które MAJĄ być śledzone)
!sprawozdanie.tex
!sprawozdanie.pdf
!zalozenia.tex
!zalozenia.pdf
!prezentacja.tex
!prezentacja.pdf
!zrzuty/
!zrzuty/**
!tabele/
!tabele/**
!wyniki.tex
