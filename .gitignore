# =============================================================================
#  Główny .gitignore projektu ZSiSK
#  Podfoldery mają własne pliki .gitignore (implementacja/, analiza/, obrazy/, sprawko/).
# =============================================================================

# --- Pliki asystenta AI (Claude Code) – lokalne, nie do repozytorium ----------
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
.claude/
.mcp.json

# --- Kompilacja C++ / CMake / Ninja ------------------------------------------
build/
build-*/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
.ninja_deps
.ninja_log
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.exe
*.out.d

# --- Qt Creator ---------------------------------------------------------------
.qtcreator/
CMakeLists.txt.user*
*.pro.user*
.qmake.stash

# --- Pliki pomocnicze LaTeX-a --------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- Wyniki ręcznych prób (edge_cli zapisuje domyślnie w bieżącym katalogu) ----
output.jpg
output.png

# --- Edytory i system ------------------------------------------------------------
.vscode/
.idea/
.cache/
*.swp
*~
.DS_Store
Thumbs.db
